# Sera Khabar storefront <-> Merchant Suite dashboard connection.
# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Catalog API base:  {MERCHANT_SUITE_URL}/api/public/v1/storefronts/{VITE_STOREFRONT_ID}
# Checkout API:      {MERCHANT_SUITE_URL}/api/public/v1/{VITE_STOREFRONT_HANDLE}/orders

# --- Client (Vite) -----------------------------------------------------------
# Anything VITE_-prefixed is compiled into the public JS bundle and is readable
# by anyone. Never put a secret here.
#
# Local dev: the Merchant Suite dev server (default port 5002).
# Vercel:    the Suite's public URL — or the ngrok tunnel while it runs locally,
#            since Vercel cannot reach localhost. Rebuild after changing this;
#            the value is baked in at build time.
VITE_MERCHANT_SUITE_URL=http://localhost:5002

# Fixed Sera Khabar workspace id. Do not change.
VITE_STOREFRONT_ID=690aa8b3-6657-46c4-8df5-addcc1f96035
VITE_STOREFRONT_HANDLE=serakhabar

# Public Turnstile site key. The secret stays only in Merchant-Suite.
VITE_TURNSTILE_SITE_KEY=

# --- Server ------------------------------------------------------------------
# Same URL as above. Used by the server-side checkout POST (api/orders.ts on
# Vercel, server/order-service.ts locally).
MERCHANT_SUITE_URL=http://localhost:5002
STOREFRONT_HANDLE=serakhabar

# SECRET. Authenticates the order webhook. Must match the value stored in the
# Suite's app_settings under "<orgId>:custom_store_api_key".
CUSTOM_ORDERS_API_KEY=

# SECRET. At least 32 characters, identical in both Vercel projects. Signs the
# customer's IP, device cookie and checkout telemetry at the storefront proxy.
# Server-only: never add a VITE_ variant. Set on both projects and redeploy
# before enabling active order protection in Merchant Suite.
STOREFRONT_CONTEXT_SECRET=

# SECRET. Dedicated 32+ character key shared with Merchant Suite and the
# /go campaign redirect middleware. Do not rotate STOREFRONT_CONTEXT_SECRET for this.
CAMPAIGN_EDGE_SECRET=

# SECRET. Meta Conversions API access token for Pixel 1433713624268170. Server-only;
# without it the server half of Meta tracking is skipped. Never add a VITE_ variant.
META_CAPI_TOKEN=

# Optional. Events Manager -> Test Events code; remove after testing.
META_TEST_EVENT_CODE=
