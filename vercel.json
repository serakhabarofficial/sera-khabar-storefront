{
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/go/:slug",
      "destination": "/api/go?__campaign_slug=:slug"
    },
    {
      "source": "/product/stepprs-massage-insoles",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/massage-insoles",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/4-in-1-makeup-pen",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/bordeaux",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/plum-veil",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/rosy-bloom",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/product/mauve-nude",
      "destination": "/api/legacy-gone"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|product(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/step/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|mjs|jsx|ts|tsx))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|gif|png|svg|ico|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff|woff2|ttf|eot|otf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:json|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist/public",
  "images": {
    "sizes": [
      640,
      750,
      828,
      1080,
      1200,
      1920,
      2048,
      3840
    ],
    "qualities": [
      50,
      60,
      70,
      80,
      90,
      100
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "xnuiaxygeoydtopvcmli.supabase.co"
      }
    ]
  }
}
